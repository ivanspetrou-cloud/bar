{
  "manifest_version": 3,
  "name": "Bar — YouTube Music",
  "version": "0.2.2",
  "description": "Связывает вкладку YouTube Music с нотчем Bar на этом компьютере. Работает только на music.youtube.com; подключаться может только к Bar на 127.0.0.1 — в интернет ничего не отправляет.",
  "key": "",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:47823 ws://127.0.0.1:47824 ws://127.0.0.1:47825 'self'"
  }
}