{
  "manifest_version": 3,
  "name": "Bar — музыка в браузере",
  "version": "0.4.3",
  "description": "Связывает музыкальные вкладки с нотчем Bar на этом компьютере: YouTube Music полностью, остальные сайты (Яндекс Музыка, SoundCloud, Spotify и др.) — плеер. Подключается только к Bar на 127.0.0.1 — в интернет ничего не отправляет.",
  "key": "",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://music.yandex.by/*",
    "https://music.yandex.kz/*",
    "https://soundcloud.com/*",
    "https://open.spotify.com/*",
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://music.apple.com/*",
    "https://www.deezer.com/*",
    "https://listen.tidal.com/*",
    "https://*.bandcamp.com/*",
    "https://zvuk.com/*",
    "https://music.amazon.com/*",
    "https://music.amazon.de/*",
    "https://www.mixcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*",
        "https://vk.com/*",
        "https://vk.ru/*",
        "https://music.apple.com/*",
        "https://www.deezer.com/*",
        "https://listen.tidal.com/*",
        "https://*.bandcamp.com/*",
        "https://zvuk.com/*",
        "https://music.amazon.com/*",
        "https://music.amazon.de/*",
        "https://www.mixcloud.com/*"
      ],
      "js": [
        "web.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*",
        "https://vk.com/*",
        "https://vk.ru/*",
        "https://music.apple.com/*",
        "https://www.deezer.com/*",
        "https://listen.tidal.com/*",
        "https://*.bandcamp.com/*",
        "https://zvuk.com/*",
        "https://music.amazon.com/*",
        "https://music.amazon.de/*",
        "https://www.mixcloud.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:47823 ws://127.0.0.1:47824 ws://127.0.0.1:47825 'self'"
  }
}